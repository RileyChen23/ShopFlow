# DeepSeek official Chat Completions. Fill only the key locally.
HOST=127.0.0.1
PORT=8765
DATABASE_PATH=data/shopping.sqlite3
AGENT_MODE=live
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Explicit non-thinking, non-streaming; no private reasoning collected.
LLM_THINKING=disabled
LLM_TIMEOUT_SECONDS=35
LLM_RUN_TIMEOUT_SECONDS=150
LLM_MAX_CALLS=8
LLM_MAX_TOOLS=20
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_INPUT_BYTES=48000
LLM_DAILY_CALL_LIMIT=20
# Initialize explicitly with python budget.py --id local-validation --cap 40
LLM_BUDGET_ID=local-validation
EVAL_MAX_CASES=8
# Rates CNY / million tokens, official peak/off-peak schedule checked 2026-09-08.
LLM_PRICE_SOURCE=https://api-docs.deepseek.com/zh-cn/quick_start/pricing/
LLM_PRICE_DATE=2026-09-08
STRATEGY_VERSION=v2
LLM_PROMPT_VERSION=shopflow
# Real-mode product discovery. Tavily basic search uses one credit per request.
SEARCH_PROVIDER=tavily
SEARCH_BASE_URL=https://api.tavily.com/search
SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5
ENABLE_TEST_LAB=0
SHOPIFY_STORE=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_TEST_STORE_ACK=0
SHOPIFY_API_VERSION=2026-07

